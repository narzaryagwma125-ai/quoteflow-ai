# --- Core ---
APP_ENV=development
SECRET_KEY=replace_with_long_random_secret_at_least_32_chars
DATABASE_URL=postgresql+asyncpg://quoteflow:quoteflow_dev_password@localhost:5432/quoteflow
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
LOG_LEVEL=INFO

# --- Sessions ---
SESSION_COOKIE_NAME=quoteflow_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_LIFETIME_DAYS=30

# --- Email ---
# Uses Resend's HTTPS API so it works on Render Free without SMTP ports.
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com/emails
EMAIL_API_TIMEOUT_SECONDS=20
# Must be a sender/domain verified in Resend.
EMAIL_FROM=no-reply@your-verified-domain.com
# Where contact form messages are delivered.
SUPPORT_EMAIL=support@your-verified-domain.com
# Require email verification on signup.
EMAIL_VERIFICATION_REQUIRED=true

# --- AI ---
GEMINI_API_KEY=
# Leave empty to auto-select the first model that supports content generation
# for the configured key; or pin one, e.g. GEMINI_MODEL=models/gemini-2.5-flash.
GEMINI_MODEL=
AI_MODELS_CACHE_TTL_SECONDS=300

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
STRIPE_SUCCESS_URL=http://localhost:3000/billing?checkout=success
STRIPE_CANCEL_URL=http://localhost:3000/billing?checkout=cancelled

# --- Free Trial ---
FREE_TRIAL_ENABLED=true
FREE_TRIAL_DAYS=5
FREE_TRIAL_UNLIMITED=false

# --- Development-only limits (ignored when APP_ENV=production) ---
# Lift the monthly quote limit so you can test the full quote flow locally.
DEV_IGNORE_QUOTE_LIMITS=true

# --- Uploads ---
UPLOAD_DIR=./uploads
MAX_LOGO_SIZE_BYTES=2097152
# Custom quotation templates are capped at 5 MB in code (not configurable).



ENABLE_AI=false
ENABLE_STRIPE=false