# Core
APP_ENV=development
SECRET_KEY=replace_with_long_random_secret_at_least_32_chars
DATABASE_URL=postgresql+asyncpg://quoteflow:quoteflow_dev_password@localhost:5432/quoteflow
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
LOG_LEVEL=INFO

# Sessions
SESSION_COOKIE_NAME=quoteflow_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_LIFETIME_DAYS=30

# Brevo SMTP
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=your-brevo-smtp-login
SMTP_PASSWORD=your-brevo-smtp-key
SMTP_TIMEOUT_SECONDS=20
EMAIL_FROM=hello@quoteflowai.in
SUPPORT_EMAIL=hello@quoteflowai.in
EMAIL_VERIFICATION_REQUIRED=true

# AI
GEMINI_API_KEY=
GEMINI_MODEL=
AI_MODELS_CACHE_TTL_SECONDS=300

# Razorpay Subscriptions
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_STARTER_PLAN_ID=
RAZORPAY_PRO_PLAN_ID=
RAZORPAY_BUSINESS_PLAN_ID=
RAZORPAY_API_TIMEOUT_SECONDS=20
RAZORPAY_TOTAL_COUNT=120
RAZORPAY_SUCCESS_URL=http://localhost:3000/billing?checkout=success
RAZORPAY_CANCEL_URL=http://localhost:3000/billing?checkout=cancelled

# Free Trial
FREE_TRIAL_ENABLED=true
FREE_TRIAL_DAYS=5
FREE_TRIAL_UNLIMITED=false
DEV_IGNORE_QUOTE_LIMITS=true

# Uploads
UPLOAD_DIR=./uploads
MAX_LOGO_SIZE_BYTES=2097152
ENABLE_AI=false
ENABLE_RAZORPAY=false
